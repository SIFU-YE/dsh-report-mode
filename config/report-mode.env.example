# dsh-report-mode 环境变量模板
#
# 用法：把本文件内容拷进 <DSH_HOME>/.env（Windows 一般是 %USERPROFILE%\.dsh\.env），
# 填上真实值。DSH 启动时会把它作为 user 层加载（继承的 process.env 优先，
# 也就是说系统环境变量 / 启动前导出的变量会盖过本文件）。
#
# 为什么放 .env 而不是写在插件或预设里：预设会被复制进
# <DSH_HOME>/.agent-presets/report-mode，而那是纯文本、会被 git 跟踪的形态。
# 私有仓库也一样不该有明文口令——仓库一旦推送，口令就应视为已泄漏。
#
# 本文件刻意只写占位符与环境变量名，不写任何本机绝对路径：
# 换机器时只需要填 / 改本文件，不需要改插件或预设（发布前由
# scripts/scan-secrets.mjs 的"可迁移性"规则把关）。
#
# 只有被注释掉的行表示"保持缺省/留空"。留空的连接参数会让对应的 MCP 服务器
# 连不上库，表现为查询工具报连接错误。
#
# ⚠ 两条实测定下来的写法要求（DSH 用 node:util 的 parseEnv 解析本文件）：
#   1. 值里含 # 必须加引号。未加引号时 # 会被当成注释起点：
#        PASSWORD=pass!@#     -> 实际得到 "pass!@"
#        PASSWORD="pass!@#"   -> 正确
#   2. Windows 路径用单反斜杠，不要转义（下面用 <盘符> 占位，换成你的盘符即可）：
#        ROOTS="<盘符>:\报表工作区"      -> 正确
#        ROOTS="<盘符>:\\报表工作区"     -> 会得到两个反斜杠

# ── Doris（报表取数库）──────────────────────────────────────────────────────
REPORT_DORIS_HOST=your-doris-host
REPORT_DORIS_PORT=9030
REPORT_DORIS_USER=your_user
REPORT_DORIS_PASSWORD=your_password
# Doris 的默认数据库：真实 .cpt 的 Doris SQL 既有 schema.table 也有未限定表名（如
# FROM sales_basics_finally），不配默认库时真实库校验会报 No database selected/未知表。
REPORT_DORIS_DATABASE=your_doris_database

# ── MySQL（填报库）──────────────────────────────────────────────────────────
REPORT_MYSQL_HOST=your-mysql-host
REPORT_MYSQL_PORT=3306
REPORT_MYSQL_USER=your_user
REPORT_MYSQL_PASSWORD=your_password
REPORT_MYSQL_DATABASE=your_database

# ── 测试库（测试环境数据库-主节点）──────────────────────────────────────────
# 只读账号：只做 SELECT / SHOW / EXPLAIN，不做写入。
REPORT_TESTDB_HOST=your-testdb-host
REPORT_TESTDB_PORT=3308
REPORT_TESTDB_USER=your_readonly_user
REPORT_TESTDB_PASSWORD=your_password

# ── cpt-mcp 的真实库连接（自动生成，不需要第二份配置）─────────────────────
# 预设会用上面三组 REPORT_* 自动拼出 cpt-mcp 的 CPT_DB_CONNECTIONS（cpt-mcp 的最高
# 优先级连接源），连接名覆盖 .cpt 里实际在用的名字：
#   Doris               → REPORT_DORIS_*（含 REPORT_DORIS_DATABASE）
#   填报-读写、MySQL    → REPORT_MYSQL_*
#   testdb、测试库      → REPORT_TESTDB_*
# 因此 cpt-mcp 的 run_dataset_sql_check(target:"real") / dataset_sql_parity 与
# doris/mysql/testdb 三个 MCP 用的是同一批凭据；**不需要**再维护
# ~/.cpt-mcp/db-connections.json（那份文件只在没有本组变量时兜底）。
#
# ⚠ 未自动映射的连接名（真实模板实测存在，需要时整串覆盖）：
#   · 「外接数据库」= FineDB 平台库（真实 .cpt 里查 fine_user / fine_department），
#     不是 Doris——0.1.31 起不再把「外接数据库」指向 REPORT_DORIS_*；
#   · 「FRDemo」与「middle读写」模板也在用，但没有对应的 REPORT_* 组。
# 这些连接需要人工在下面的 REPORT_CPT_DB_CONNECTIONS 里整串补齐（值仍只写在本文件）。
#
# 需要整串覆盖时（高级用法，值仍只写在本文件里、不进仓库）：
#REPORT_CPT_DB_CONNECTIONS={"Doris":{"host":"your-doris-host","port":9030,"user":"your_user","password":"your_password","database":"your_doris_database"}}

# ── 外部 MCP 命令（迁移/非标准安装位置）────────────────────────────────────
# 默认从 PATH 找 cpt-mcp / fr-docs-mcp。若装在非标准位置、PATH 上没有，
# 用下面的变量指向可执行文件或启动入口（值只写在本文件，不进仓库）。
#REPORT_CPT_MCP_COMMAND=cpt-mcp
#REPORT_FR_DOCS_MCP_COMMAND=fr-docs-mcp

# ── mysql-mcp-server / MCP 服务器启动方式 ───────────────────────────────────
# 缺省是 `npx -y mysql-mcp-server`（无需预装，走 npm 缓存）。
# 若你要指向本机已有的构建产物，把 COMMAND 设为 node、ENTRY 设为那个 .js 的完整路径
# （这种"指向本机文件"的值只写在本文件里，不进仓库）。
#REPORT_MYSQL_MCP_COMMAND=npx
#REPORT_MYSQL_MCP_ENTRY=mysql-mcp-server

# excel MCP 用的 python 解释器：缺省用命令名 `python`（走 PATH）。
# 只有在 PATH 上的 python 不是你要的那个时，才在这里写完整路径。
#REPORT_EXCEL_MCP_PYTHON=python

# ── cpt-mcp 的路径白名单 ────────────────────────────────────────────────────
# cpt-mcp 自带围栏：只允许操作白名单目录内的 .cpt。缺省顺序为
#   显式值（本变量） -> 会话工作区（DSH_CWD） -> 用户主目录。
# ⚠ DSH 不把 DSH_CWD 导出到自己的进程（实测为空），所以只要报表目录不在用户主目录下，
#   就【必须】在这里显式设置，否则 cpt-mcp 会拒绝所有 .cpt 路径。
# 分号分隔的目录列表；支持相对路径（按 MCP 进程 cwd 解析），例如：
#CPT_MCP_ALLOWED_ROOTS="./报表工作区;./报表备份"

# ── 其他可选开关 ────────────────────────────────────────────────────────────
# 报表产物只做本地 git 提交（不上云、不建远端）；本预设不注册 push 工具，
# 因此不需要 Gitee/GitHub 推送凭据。
# cpt-mcp 的工具档位（缺省 report：报表常用集，约 24k token）。
#CPT_MCP_TOOL_PROFILE=report
# 数据集 SQL 校验的默认目标（2026-11-04 测试环境口径）：
#   local  = 内置 SQLite 本地测试库（缺省；本地库没建时返回 nextAction 引导）
#   real   = 真实库（旧默认；真实库只读，适合交付前最终核对）
#   both   = 真实库 + 本地对账
# report-mode 预设已显式注入 local；此变量可覆盖（全局或本文件均可）。
#CPT_MCP_SQL_TARGET=local
# 浏览器调试用的 MCP 入口：0.1.31 起缺省钉版本 chrome-devtools-mcp@1.12.0（本机已缓存），
# 避免 @latest 漂移。换机/清 npm 缓存后 npx 首次启动可能联网拉包，需要预装或在这里改成本机可用的入口。
# 浏览器网络层 allowlist（预设里的 --allowedUrlPattern）需要 Chrome 149+（本机 Chrome 156）；
# Chrome 更旧时该参数可能让 MCP 启动失败——升级 Chrome，或临时把入口改回旧版本并删掉预设里
# 的 --allowedUrlPattern 段（此时只剩工具层 guard，evaluate_script 内的网络访问不再被硬拦）。
#REPORT_BROWSER_MCP_ENTRY=chrome-devtools-mcp@1.12.0

