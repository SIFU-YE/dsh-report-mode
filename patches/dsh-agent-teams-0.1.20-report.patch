diff --git a/lib/memory.js b/lib/memory.js
new file mode 100644
index 0000000..909558b
--- /dev/null
+++ b/lib/memory.js
@@ -0,0 +1,91 @@
+/**
+ * AgentTeams scoped memory: per-member private memory + teamleader grants.
+ *
+ * Added by the dsh-report-mode patch (报表模式需求 2): teammate memory sharing
+ * is restricted. Each member has a private memory namespace under
+ *   <stateDir>/<teamId>/memory/<memberName>.jsonl
+ * The captain has `captain.jsonl`. A member can only read their own memory
+ * unless the captain grants them read access to another member's namespace.
+ * Grants persist in <stateDir>/<teamId>/memory/grants.json.
+ *
+ * This is a lightweight, file-backed memory pool. It is deliberately additive:
+ * nothing in the patched upstream modules other than the three tool
+ * registrations in tools.js depends on it.
+ * @module dsh-agent-teams/memory
+ */
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+export const MEMORY_DIR = 'memory';
+export const GRANTS_FILE = 'grants.json';
+export const MEMORY_CAPTAIN_KEY = 'captain';
+async function ensureMemoryDir(stateRoot, teamId) {
+    await mkdir(join(stateRoot, teamId, MEMORY_DIR), { recursive: true });
+}
+/** One namespace file per member; the name is sanitized so it stays a file name. */
+function memoryFilePath(stateRoot, teamId, memberName) {
+    return join(stateRoot, teamId, MEMORY_DIR, `${memberName.replace(/[^\w.-]+/g, '_')}.jsonl`);
+}
+function grantsFilePath(stateRoot, teamId) {
+    return join(stateRoot, teamId, MEMORY_DIR, GRANTS_FILE);
+}
+/** Append one entry to a member's own namespace and return it. */
+export async function appendMemory(stateRoot, teamId, memberName, content) {
+    await ensureMemoryDir(stateRoot, teamId);
+    const entry = { id: randomUUID(), member: memberName, content, ts: Date.now() };
+    const file = memoryFilePath(stateRoot, teamId, memberName);
+    let existing = '';
+    try {
+        existing = await readFile(file, 'utf8');
+    }
+    catch {
+        // First write for this namespace.
+    }
+    const separator = existing.length > 0 && !existing.endsWith('\n') ? '\n' : '';
+    await writeFile(file, `${existing}${separator}${JSON.stringify(entry)}\n`, 'utf8');
+    return entry;
+}
+/** Read one namespace, oldest first; an absent namespace reads as empty. */
+export async function readMemory(stateRoot, teamId, memberName) {
+    const file = memoryFilePath(stateRoot, teamId, memberName);
+    try {
+        const text = await readFile(file, 'utf8');
+        return text.split('\n').filter(Boolean).map((line) => JSON.parse(line));
+    }
+    catch {
+        return [];
+    }
+}
+/** Every grant recorded for this team; an absent file reads as none. */
+export async function readGrants(stateRoot, teamId) {
+    const file = grantsFilePath(stateRoot, teamId);
+    try {
+        const text = await readFile(file, 'utf8');
+        return JSON.parse(text);
+    }
+    catch {
+        return [];
+    }
+}
+async function writeGrants(stateRoot, teamId, grants) {
+    await ensureMemoryDir(stateRoot, teamId);
+    await writeFile(grantsFilePath(stateRoot, teamId), JSON.stringify(grants, null, 2), 'utf8');
+}
+/** Grant `grantee` read access to `scope`; granting twice is a no-op. */
+export async function grantMemory(stateRoot, teamId, grantedBy, grantee, scope) {
+    const grants = await readGrants(stateRoot, teamId);
+    const existing = grants.find((grant) => grant.grantee === grantee && grant.scope === scope);
+    if (existing !== undefined)
+        return existing;
+    const grant = { grantee, scope, grantedBy, ts: Date.now() };
+    grants.push(grant);
+    await writeGrants(stateRoot, teamId, grants);
+    return grant;
+}
+/** Whether `callerName` may read `scope`: own namespace, captain, or a grant. */
+export async function canReadMemory(stateRoot, teamId, callerName, scope) {
+    if (callerName === scope || callerName === MEMORY_CAPTAIN_KEY)
+        return true;
+    const grants = await readGrants(stateRoot, teamId);
+    return grants.some((grant) => grant.grantee === callerName && grant.scope === scope);
+}
